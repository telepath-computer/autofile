{
  // The root config holds the compiler options every package shares; this one
  // emits `dist` from `src`. The tests are left out of it, so nothing that only
  // describes the code is published with it.
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "sourceMap": true,
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src"]
}
