{
  "name": "@autofile/core",
  "version": "0.1.0",
  "description": "The vault model: collections, records, blobs, references and findings.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/*.tsbuildinfo"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "test": "tsc -b && node --test \"src/**/*.test.ts\"",
    "typecheck": "tsc -b"
  }
}
