{
  "name": "@telepath-computer/autofile",
  "version": "0.5.0",
  "description": "Predictable filing for agents.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/telepath-computer/autofile.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "autofile": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "prepack": "npm run build",
    "prelint": "npm run build",
    "lint": "tsc -p tsconfig.json",
    "pretest": "npm run build",
    "test": "node --test test/*.test.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/mime-types": "3.0.1",
    "@types/node": "^24.0.0",
    "@types/proper-lockfile": "4.1.4",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@hyperjump/json-schema": "1.18.0",
    "@hyperjump/json-schema-errors": "1.0.0",
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "chokidar": "5.0.0",
    "mime-types": "3.0.1",
    "mingo": "7.2.4",
    "proper-lockfile": "4.1.2"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  }
}
