{
  "name": "@telepath-computer/autofile-server",
  "version": "0.1.0",
  "description": "A local HTTP server that exposes autofile vaults to apps.",
  "type": "module",
  "bin": {
    "autofile-server": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "tsc -b && concurrently \"npm:dev:*\"",
    "dev:ui": "vite build --watch",
    "dev:server": "tsc -b --watch --preserveWatchOutput",
    "dev:cli": "node --watch dist/src/cli.js --vault main=../example --host 0.0.0.0 --port 8767",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\" && vitest run",
    "lint": "tsc -b --noEmit",
    "check": "npm run lint && npm test"
  },
  "dependencies": {
    "express": "^4.19.2",
    "gray-matter": "^4.0.3",
    "js-yaml": "^3.15.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^3.12.10",
    "@types/node": "^20.14.10",
    "concurrently": "^10.0.4",
    "jsdom": "^29.1.1",
    "typescript": "^5.5.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist/src",
    "dist/ui"
  ]
}
