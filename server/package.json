{
  "name": "@telepath-computer/autofile-server",
  "version": "0.1.0",
  "description": "A local HTTP server that exposes autofile vaults to apps.",
  "type": "module",
  "bin": {
    "autofile-server": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "lint": "tsc -p tsconfig.json --noEmit",
    "check": "npm run lint && npm test"
  },
  "dependencies": {
    "express": "^4.19.2",
    "gray-matter": "^4.0.3",
    "js-yaml": "^3.15.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^3.12.10",
    "@types/node": "^20.14.10",
    "typescript": "^5.5.3"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist/src"
  ]
}
